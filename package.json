        "yace": "^1.1.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/audioworklet": "^0.0.100",
        "@types/node": "^26.1.2",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "^7.0.2001",
        "typescript": "^7.0.2",
        "vite": "^8.2.0"
    }
