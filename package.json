{
    "name": "remote-control",
    "version": "1.0.0",
    "description": "Remote desktop control system with Rust backend and web frontend",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "pnpm check && vite build",
        "preview": "vite preview",
        "check": "tsc -b --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "tlint": "oxlint --type-aware",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "dependencies": {
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-web-links": "^0.12.0",
        "@xterm/xterm": "^6.0.0",
